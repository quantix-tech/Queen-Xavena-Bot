# Queen Xavena Bot — environment variables
# Copy to .env and fill in what you need. All vars are optional
# EXCEPT that you need to provide a session somehow (see below).

# ── Session ────────────────────────────────────────────────
# Optional. Overrides session_id.txt if set. Useful for Docker
# or serverless where you don't want session files in the image.
# SESSION_ID=QueenXavena~eyJub2lzZUtleSI6...

# ── Logging ────────────────────────────────────────────────
# fatal | error | warn | info | debug | trace | silent
# Default: silent. Use "debug" when diagnosing connection issues.
# LOG_LEVEL=silent

# ── Baileys ────────────────────────────────────────────────
# Pin a specific WhatsApp Web version if auto-fetch fails.
# BAILEYS_VERSION=2,3000,1023223821